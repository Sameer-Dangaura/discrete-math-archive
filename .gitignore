# #: is used to comment out in Git. 
# Since, `.gitignore` file is read by Git. So, # is also used in `.gitignore` file to comment out.

# * : matches anything (including nothing)


# Ignore compiled executable files
*.exe
*.out
*.o

# Ignore backup files
*~

# Ignore temporary editor files (e.g., Vim, VS Code)
*.swp
.vscode/

# Ignore object dump files
*.obj

# Ignore specific files which starts name with chatgpt i.e. chatgpt*.c and ends name with chatgpt i.e. *chatgpt.c
chat*.c 
cha*.c 
*chatgpt.c 


# Ignore specific files:
